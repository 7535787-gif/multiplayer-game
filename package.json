{
  "name": "multiplayer-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint --config client/eslint.config.js client/src server shared tests",
    "format": "prettier --write .",
    "test": "npm run build:server && vitest run && node --test \"tests/*.test.js\"",
    "benchmark:protocol": "node tests/protocol-benchmark.js",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p client && tsc --noEmit -p server",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:shared": "vitest run shared",
    "test:integration": "npm run build:server && node --test --test-concurrency=1 tests/integration/*.mjs",
    "test:client": "vitest run client/src",
    "test:server": "vitest run server/src",
    "loadtest": "node scripts/load-test.mjs",
    "profile:server": "node --cpu-prof --experimental-strip-types server/src/index.ts",
    "benchmark:worker": "node scripts/worker-benchmark.mjs",
    "bots": "node scripts/add-bots.mjs",
    "perf:capture": "node scripts/perf-capture.mjs",
    "build:server": "npm run build -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
