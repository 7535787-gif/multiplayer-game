{
  "name": "multiplayer-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint --config client/eslint.config.js client/src server shared tests",
    "format": "prettier --write .",
    "test": "node --test",
    "benchmark:protocol": "node tests/protocol-benchmark.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9"
  }
}
